# PostgreSQL (Supabase: Project Settings → Database → URI)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Session encryption (32+ random bytes, base64 or hex ok if long enough)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD="replace_with_64_char_hex_minimum_32_bytes"

# Optional: set per-user seed PINs (min 6 characters) before first seed
# SEED_PIN_OMER=
# SEED_PIN_TUGRAHAN=
# SEED_PIN_EFE=
# SEED_PIN_TALHA=
# SEED_PIN_CANO=
# Or one default for all (dev only):
# SEED_PIN_DEFAULT=

# Optional: enable Web Push notifications.
# Generate once with:  npx web-push generate-vapid-keys
# Then paste the values here:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:you@example.com"

# Optional: comma-separated admin user slugs for /admin
# ADMIN_SLUGS="omer,tugrahan"

NODE_ENV=development
